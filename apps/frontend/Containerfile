# Stage 1: Build
FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/frontend/package.json apps/frontend/
RUN npm ci --workspace=@embassywatch/frontend

COPY tsconfig.base.json ./
COPY apps/frontend/ apps/frontend/
RUN npm run build --workspace=@embassywatch/frontend

# Stage 2: Serve
FROM nginx:alpine-slim

# Fix permissions for OpenShift (runs as random UID)
RUN mkdir -p /var/cache/nginx/client_temp \
    /var/cache/nginx/proxy_temp \
    /var/cache/nginx/fastcgi_temp \
    /var/cache/nginx/uwsgi_temp \
    /var/cache/nginx/scgi_temp && \
    chmod -R 777 /var/cache/nginx && \
    chmod -R 777 /var/run && \
    sed -i 's/listen\s*80;/listen 8080;/' /etc/nginx/conf.d/default.conf || true

COPY --from=build /app/apps/frontend/dist /usr/share/nginx/html
COPY apps/frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Use port 8080 for non-root
RUN sed -i 's/listen 80;/listen 8080;/' /etc/nginx/conf.d/default.conf

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
