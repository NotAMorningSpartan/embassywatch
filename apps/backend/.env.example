# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=embassywatch
DB_LOGGING=false

# Server
PORT=4000
NODE_ENV=development

# Authentication
JWT_SECRET=change-me-in-production

# Redis
REDIS_URL=redis://localhost:6379

# AI Endpoint (optional — OpenAI-compatible, e.g. OpenShift AI / vLLM)
AI_ENDPOINT_URL=
AI_MODEL_NAME=default
AI_API_KEY=
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2048
AI_TIMEOUT=60
ANALYSIS_CRON=0 */6 * * *

# Data Aggregation
USE_MOCK_DATA=true
AGGREGATION_CRON=*/30 * * * *
AGGREGATE_ON_STARTUP=true
NEWSAPI_KEY=
OPENWEATHER_KEY=
